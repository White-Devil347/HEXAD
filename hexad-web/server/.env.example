# Server Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Encryption Keys
PHOTO_ENCRYPTION_KEY=your-32-character-encryption-key

# Session Configuration
SESSION_CODE_VALIDITY_MINUTES=10
MAX_OFFLINE_SYNC_HOURS=24

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (comma-separated list of allowed browser origins)
# Example (Vercel + local dev):
# CORS_ORIGINS=https://hexad-web.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Firebase (Realtime Database)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.YOUR_REGION.firebasedatabase.app
