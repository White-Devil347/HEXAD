<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/dialogRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logging out is monitored for attendance integrity."
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/reasonRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioDeviceChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device change" />

            <RadioButton
                android:id="@+id/radioAppReinstall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App reinstall" />

            <RadioButton
                android:id="@+id/radioTechnicalIssue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Technical issue" />

            <RadioButton
                android:id="@+id/radioOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otherReasonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter reason"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otherReasonEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

