# MongoDB Connection String (REQUIRED)
# Use MongoDB Atlas URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/hexad-simulator?retryWrites=true&w=majority
# Get this from MongoDB Atlas dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/hexad-simulator?retryWrites=true&w=majority

# Server Configuration
PORT=5000

# Environment Setting
# development: Load .env file, allows localhost
# production: Requires MONGODB_URI, no localhost fallback
NODE_ENV=development

# ==========================================
# PRODUCTION HEXAD BACKEND INTEGRATION
# ==========================================
# Public session discovery + trusted attendance submission
HEXAD_API_BASE_URL=https://hexad-api.onrender.com/api

# Trusted internal key (MUST match backend INTERNAL_ATTENDANCE_BYPASS_KEY)
HEXAD_INTERNAL_KEY=replace-with-your-internal-key

# Default college ID used for session discovery and attendance submissions
COLLEGE_ID=college_001

# ==========================================
# DEPLOYMENT TO RENDER
# ==========================================
# 1. Create new Web Service on render.com
# 2. Connect GitHub repository
# 3. Set Environment Variables in Render Dashboard:
#    - MONGODB_URI=mongodb+srv://...
#    - PORT=5000
#    - NODE_ENV=production
# 4. Build Command: npm install
# 5. Start Command: npm start
# 6. Deploy!
# ==========================================

# DO NOT commit .env file with real credentials to git
# Use .env.example for documentation only
